      "id": "mf-001",
      "type": "concept",
      "statement": "Lantern-moss glows brightest in the third week after rain.",
      "detail": "The glow fades if the hollow dries before the third week.",
      "source_ref": {
        "file": "raw/mosslore/compendium.md",
        "loc": "p.12",
        "quote": "Lantern-moss glows brightest in the third week after rain."
      },
      "as_of": "2026-07-19",
      "source_version": "1.0",
      "tags": ["lantern-moss", "glow"],
      "difficulty": 2,
      "prereqs": []
    },
    {
      "id": "mf-002",
      "type": "rule",
      "statement": "Never harvest whispermoss before the frost-bell rings.",
      "source_ref": {
        "file": "raw/mosslore/compendium.md",
        "loc": "p.31",
        "quote": "Never harvest whispermoss before the frost-bell rings."
      },
