      "source_version": "1.0",
      "tags": ["whispermoss"],
      "difficulty": 3,
      "prereqs": ["mf-001"]
    },
    {
      "id": "mf-003",
      "type": "number",
      "statement": "A healthy moss-hollow holds seven singing stones.",
      "source_ref": {
        "file": "raw/mosslore/compendium.md",
