  "encounters": [
    {
      "id": "me-001",
      "fact_ids": ["mf-001"],
      "kind": "mcq",
      "template_vars": { "moss": "lantern-moss" },
      "prompt": "When does {{moss}} glow brightest after rain?",
      "options": ["First week", "Second week", "Third week", "It never glows"],
      "answer": "Third week",
      "trap_notes": "Distractors are the adjacent weeks — tests precise recall, not vibe."
    },
    {
      "id": "me-002",
      "fact_ids": ["mf-002"],
      "kind": "free_recall",
      "prompt": "Recite the whispermoss harvest rule.",
      "rubric": "Credit if the answer says to wait for the frost-bell before harvesting whispermoss."
    },
    {
      "id": "me-003",
      "fact_ids": ["mf-004"],
      "kind": "scenario_branch",
      "prompt": "An emberfox pads toward the dampmoss beds. What do you do?",
      "branches": [
        { "label": "Shoo it away gently", "outcome": "The dampmoss beds are safe.", "correct": true },
        { "label": "Let it warm itself", "outcome": "The dampmoss withers by morning.", "correct": false }
      ]
    },
    {
      "id": "me-004",
      "fact_ids": ["mf-001", "mf-003"],
      "kind": "match",
      "prompt": "Match each moss to its trait.",
      "options": [["Lantern-moss", "Whispermoss"], ["glow", "song"]],
      "answer": [["Lantern-moss", "glow"], ["Whispermoss", "song"]]
    },
    {
      "id": "me-005",
      "fact_ids": ["mf-001", "mf-002"],
      "kind": "order",
      "prompt": "Put the whispermoss harvest steps in order.",
      "options": ["Gather at dawn", "Wait for the frost-bell", "Dry in lantern-light"],
      "answer": ["Wait for the frost-bell", "Gather at dawn", "Dry in lantern-light"]
    }
